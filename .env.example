# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is git-ignored — it stays only on your computer, never gets committed or pushed.

META_ACCESS_TOKEN=

# Only needed if you're using the Shopify bridge page feature.
SHOPIFY_SHOP=eqqualberry.myshopify.com
SHOPIFY_ACCESS_TOKEN=
# Only set this if your storefront uses a custom domain instead of the
# *.myshopify.com one above.
# SHOPIFY_STOREFRONT_DOMAIN=eqqualberryglobal.com

# Only needed if you're using the "소재 업로드" tab's Google Drive mirroring.
# See drive_lib.py's module docstring for one-time service-account setup steps.
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# GOOGLE_DRIVE_FOLDER_ID=
